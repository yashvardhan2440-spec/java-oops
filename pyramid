import java.util.Scanner;

public class Str_py {
public static void main(String[] args) {
Scanner sc = new Scanner(System.in);

    System.out.print("Enter a string: ");
    String str = sc.nextLine();

    int n = str.length();

    for (int i = 1; i <= n; i++) {

        for (int j = 0; j < (n - i); j++) {
            System.out.print("   ");
        }

        for (int j = 0; j < i; j++) {
            System.out.print(str.charAt(j) + "     ");
        }

        System.out.println();
    }

    sc.close();
}
}
